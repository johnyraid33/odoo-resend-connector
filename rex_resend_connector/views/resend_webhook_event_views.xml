<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resend_webhook_event_list" model="ir.ui.view">
        <field name="name">resend.webhook.event.list</field>
        <field name="model">resend.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Resend Webhook Events" create="0"
                decoration-danger="state == 'failed'"
                decoration-warning="state == 'queued'"
                decoration-success="state == 'processed'">
                <field name="received_date"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
                <field name="event_date"/>
                <field name="email_id" optional="show"/>
                <field name="inbound_email_id" optional="show"/>
                <field name="attempts" optional="hide"/>
                <field name="error" optional="hide"/>
                <field name="svix_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_resend_webhook_event_form" model="ir.ui.view">
        <field name="name">resend.webhook.event.form</field>
        <field name="model">resend.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Resend Webhook Event" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="state"/>
                            <field name="received_date"/>
                            <field name="event_date"/>
                            <field name="attempts"/>
                            <field name="svix_id"/>
                        </group>
                        <group>
                            <field name="email_id"/>
                            <field name="inbound_email_id"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_resend_webhook_event_search" model="ir.ui.view">
        <field name="name">resend.webhook.event.search</field>
        <field name="model">resend.webhook.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_type"/>
                <field name="svix_id"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_resend_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">resend.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_resend_webhook_event_search"/>
    </record>
</odoo>
