<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_tree_resend" model="ir.ui.view">
        <field name="name">mail.mail.list.resend</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="resend_status" widget="badge" optional="show"
                    decoration-success="resend_status in ('delivered', 'opened', 'clicked')"
                    decoration-info="resend_status in ('sent', 'accepted', 'scheduled')"
                    decoration-warning="resend_status == 'delayed'"
                    decoration-danger="resend_status in ('bounced', 'complained', 'failed')"/>
            </xpath>
        </field>
    </record>

    <record id="view_mail_form_resend" model="ir.ui.view">
        <field name="name">mail.mail.form.resend</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_server_id']" position="after">
                <field name="resend_message_id" invisible="not resend_message_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="resend" string="Resend" groups="rex_resend_connector.group_resend_manager"
                    invisible="not resend_message_id">
                    <group>
                        <group string="Delivery">
                            <field name="resend_status"/>
                            <field name="resend_status_date"/>
                            <field name="resend_message_id"/>
                            <field name="resend_last_event_type"/>
                        </group>
                        <group string="Diagnostics">
                            <field name="resend_error"/>
                            <field name="resend_retry_count"/>
                        </group>
                    </group>
                    <field name="resend_email_ids" readonly="1">
                        <list string="Deliveries" create="0" edit="0">
                            <field name="resend_message_id"/>
                            <field name="to_emails"/>
                            <field name="state" widget="badge"/>
                            <field name="status_date"/>
                        </list>
                    </field>
                    <button name="action_open_resend_email" type="object"
                        string="Open delivery history" class="btn-link"
                        icon="fa-history" invisible="not resend_email_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>