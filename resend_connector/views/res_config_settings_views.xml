<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_resend" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.resend</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="after">
                <div id="resend_setting">
                    <block title="Resend (email API)" id="resend">
                        <setting id="resend_enabled_setting"
                            string="Send emails through Resend"
                            help="Deliver Odoo email through the Resend API instead of SMTP. No mail port is needed and every message gets a delivery status."
                            documentation="https://resend.com/docs">
                            <field name="resend_enabled"/>
                            <div class="content-group" invisible="not resend_enabled">
                                <div class="mt8">
                                    <button name="action_resend_test_connection" type="object"
                                        string="Test connection" class="btn-link"/>
                                    <button name="%(resend_connector.action_resend_test_mail)d" type="action"
                                        string="Send test email" class="btn-link"/>
                                    <button name="action_resend_open_documentation" type="object"
                                        string="Setup guide" class="btn-link"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="resend_api_setting" string="API key"
                            help="Resend API key. A key with sending access is enough to send; domain and webhook management needs full access."
                            invisible="not resend_enabled">
                            <field name="resend_api_key" password="True" placeholder="re_..."/>
                        </setting>

                        <setting id="resend_from_setting" string="From address"
                            help="Sender address on a domain verified in Resend, for example no-reply@mg.example.com."
                            invisible="not resend_enabled">
                            <field name="resend_from_email" placeholder="no-reply@mg.example.com"/>
                        </setting>

                        <setting id="resend_from_mode_setting" string="Rewrite From"
                            help="Odoo may choose a sender on a domain Resend does not know. The module can replace it and keep the original address in Reply-To."
                            invisible="not resend_enabled">
                            <field name="resend_from_mode"/>
                        </setting>

                        <setting id="resend_status_setting" string="Status"
                            invisible="not resend_enabled">
                            <field name="resend_status"/>
                            <div class="text-muted mt-1" invisible="not resend_verified_domains">
                                Verified domains: <field name="resend_verified_domains" class="oe_inline"/>
                                <span invisible="not resend_domain_count">&#160;(<field name="resend_domain_count" class="oe_inline"/> in Resend)</span>
                            </div>
                        </setting>

                        <setting id="resend_domains_setting" string="Domains"
                            invisible="not resend_enabled">
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="action_resend_sync_domains" type="object"
                                        string="Synchronise domains" class="btn-link"/>
                                    <button name="action_resend_open_domains" type="object"
                                        string="Manage domains" class="btn-link"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="resend_webhook_setting" string="Delivery webhooks"
                            help="Resend calls Odoo when an email is delivered, opened, bounced or received. The call is signed with the secret below."
                            invisible="not resend_enabled">
                            <field name="resend_webhook_url" readonly="1" widget="CopyClipboardChar"/>
                            <field name="resend_webhook_secret" password="True" placeholder="whsec_..."/>
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="action_resend_create_webhook" type="object"
                                        string="Create / update webhook in Resend" class="btn-link"
                                       />
                                    <span class="text-success ms-2" invisible="not resend_webhook_configured">
                                        <i class="fa fa-check"/> Secret configured
                                    </span>
                                    <span class="text-warning ms-2" invisible="resend_webhook_configured">
                                        <i class="fa fa-exclamation-triangle"/> Not configured yet
                                    </span>
                                </div>
                                <div class="text-muted mt-2">
                                    Odoo must be reachable from the internet at this URL. Set
                                    <b>Public Base URL</b> below if the public address is different.
                                </div>
                            </div>
                        </setting>

                        <setting id="resend_inline_setting" string="Inline images"
                            help="How inline images are sent. Content-ID keeps cid references, data URI embeds the image in the HTML, attachment sends it as a normal file."
                            invisible="not resend_enabled">
                            <field name="resend_inline_images_mode"/>
                        </setting>

                        <setting id="resend_message_id_setting" string="Send Odoo Message-ID"
                            help="Adds the Odoo Message-Id as a custom header. Resend assigns its own id; the module tracks both and maps replies back to the Odoo thread."
                            invisible="not resend_enabled">
                            <field name="resend_preserve_message_id"/>
                        </setting>

                        <setting id="resend_payloads_setting" string="Store webhook payloads"
                            help="Keep the raw JSON of every webhook call for debugging."
                            invisible="not resend_enabled">
                            <field name="resend_store_payloads"/>
                        </setting>

                        <setting id="resend_inbound_setting" string="Keep original inbound messages"
                            help="Attach the original message file to every imported incoming email."
                            invisible="not resend_enabled">
                            <field name="resend_save_inbound_original"/>
                        </setting>

                        <setting id="resend_retry_setting" string="Automatic retries"
                            help="Number of automatic retries for temporary failures: network error, rate limit or server error. Zero disables them."
                            invisible="not resend_enabled">
                            <field name="resend_auto_retry_max"/>
                        </setting>

                        <setting id="resend_retry_delay_setting" string="Retry delay (minutes)"
                            help="Delay between automatic retries."
                            invisible="not resend_enabled">
                            <field name="resend_retry_delay"/>
                        </setting>

                        <setting id="resend_rate_setting" string="Requests per second"
                            help="Resend allows 10 requests per second per team. Keep this value slightly below the limit."
                            invisible="not resend_enabled">
                            <field name="resend_rate_limit"/>
                        </setting>

                        <setting id="resend_tolerance_setting" string="Webhook tolerance"
                            help="Accepted clock difference, in seconds, for the webhook signature."
                            invisible="not resend_enabled">
                            <field name="resend_webhook_tolerance"/>
                        </setting>

                        <setting id="resend_public_url_setting" string="Public Base URL"
                            help="Public address of this Odoo instance, used to build the webhook URL. Leave empty to use the system base URL."
                            invisible="not resend_enabled">
                            <field name="resend_public_base_url" placeholder="https://odoo.example.com"/>
                        </setting>

                        <setting id="resend_base_url_setting" string="API base URL"
                            help="Change only to use a proxy or a test server. Default: https://api.resend.com"
                            invisible="not resend_enabled">
                            <field name="resend_base_url" placeholder="https://api.resend.com"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>